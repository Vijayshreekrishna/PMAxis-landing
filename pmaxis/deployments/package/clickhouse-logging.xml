<clickhouse>
    <!-- Level change alone kills ~95% of write volume (trace→warning) -->
    <text_log>
        <level>warning</level>
        <ttl>event_date + INTERVAL 7 DAY</ttl>
    </text_log>

    <!-- High volume — keep only 1 day -->
    <trace_log>
        <ttl>event_date + INTERVAL 1 DAY</ttl>
    </trace_log>

    <processors_profile_log>
        <ttl>event_date + INTERVAL 1 DAY</ttl>
    </processors_profile_log>

    <!-- Medium volume — keep 2 days -->
    <query_log>
        <ttl>event_date + INTERVAL 2 DAY</ttl>
    </query_log>

    <part_log>
        <ttl>event_date + INTERVAL 2 DAY</ttl>
    </part_log>

    <!-- Lower volume — keep 3 days -->
    <metric_log>
        <ttl>event_date + INTERVAL 3 DAY</ttl>
    </metric_log>

    <asynchronous_insert_log>
        <ttl>event_date + INTERVAL 3 DAY</ttl>
    </asynchronous_insert_log>

    <query_views_log>
        <ttl>event_date + INTERVAL 3 DAY</ttl>
    </query_views_log>

    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 3 DAY</ttl>
    </asynchronous_metric_log>

    <error_log>
        <ttl>event_date + INTERVAL 3 DAY</ttl>
    </error_log>

    <background_schedule_pool_log>
        <ttl>event_date + INTERVAL 3 DAY</ttl>
    </background_schedule_pool_log>

    <query_metric_log>
        <ttl>event_date + INTERVAL 3 DAY</ttl>
    </query_metric_log>
</clickhouse>
